<%
/**
 * 文章页：一张内容卡。设计契约 §3.5。
 */
var cfg = monish_config();
var dateFormat = cfg.posts.date_format || config.date_format || 'YYYY-MM-DD';
var categories = page.categories ? page.categories.toArray() : [];
var tags = page.tags ? page.tags.toArray() : [];
var words = cfg.post.word_count ? monish_word_count(page.content) : 0;
var minutes = cfg.post.reading_time ? monish_reading_time(page.content) : 0;
var hasToc = cfg.post.toc && /<h[1-6][^>]*id=/i.test(page.content || '');
var author = page.author || cfg.site.author || cfg.site.title;

/* 浏览量：静态站没有后端，数字由第三方服务（默认不蒜子）在前端填。
   配置见 _config.yml 的 pageview 段（默认开启）。
   文章 front-matter 写 `pageview: false` 可以单独关掉某一篇。 */
var pageview = cfg.pageview || {};
var pageviewOn = pageview.enable !== false &&
  String(pageview.provider || 'busuanzi').toLowerCase() !== 'none' &&
  page.pageview !== false;
var pageviewLabel = pageview.label || monish_t('pageview');
var pageviewSiteTotal = pageview.site_total === true;
%>
<article class="card" id="content-card" itemscope itemtype="https://schema.org/BlogPosting">
  <header class="card-head">
    <time class="post-date" datetime="<%= date_xml(page.date) %>" itemprop="datePublished"><%= monish_date_label(page.date) %></time>
    <h1 class="card-title" itemprop="name headline"><%= page.title %></h1>

    <% if (tags.length){ %>
      <div class="post-tags">
        <% tags.forEach(function (item){ %>
          <a class="tag-chip" href="<%- url_for(item.path) %>">#<%= item.name %></a>
        <% }); %>
      </div>
    <% } %>

    <dl class="card-meta">
      <div class="meta-item">
        <dt><%= monish_t('author') %></dt>
        <dd><%= author %></dd>
      </div>
      <% if (minutes){ %>
        <div class="meta-item">
          <dt><%= monish_t('reading_time') %></dt>
          <dd><%= minutes %> <%= monish_t('minutes') %></dd>
        </div>
      <% } %>
      <% if (words){ %>
        <div class="meta-item">
          <dt><%= monish_t('word_count') %></dt>
          <dd><%= words %></dd>
        </div>
      <% } %>
      <% if (pageviewOn){ %>
        <%# 浏览量：数字由前端脚本（不蒜子）填进 #busuanzi_value_page_pv。
            先用「—」占位，保持 meta 行宽稳定；4 秒内没拿到数字就由 JS 整个隐藏。 %>
        <div class="meta-item" data-pageview>
          <dt><%= pageviewLabel %></dt>
          <dd><span id="busuanzi_value_page_pv">—</span><% if (pageviewSiteTotal){ %> <span class="meta-sep">/</span> <span id="busuanzi_value_site_pv">—</span><% } %></dd>
        </div>
      <% } %>
      <% if (categories.length){ %>
        <div class="meta-item">
          <dt><%= monish_t('category') %></dt>
          <dd>
            <% categories.forEach(function (cat, i){ %>
              <a href="<%- url_for(cat.path) %>" itemprop="articleSection"><%= cat.name %></a><%= i < categories.length - 1 ? ', ' : '' %>
            <% }); %>
          </dd>
        </div>
      <% } %>
      <% if (cfg.post.updated && page.updated && page.updated.valueOf() !== page.date.valueOf()){ %>
        <div class="meta-item">
          <dt><%= monish_t('updated_on') %></dt>
          <dd><time datetime="<%= date_xml(page.updated) %>" itemprop="dateModified"><%= date(page.updated, dateFormat) %></time></dd>
        </div>
      <% } %>
    </dl>
  </header>

  <% if (hasToc){ %>
    <%# 默认收起：服务端直接渲染 is-collapsed，避免「先展开再收起」的闪烁。
       无 JS 时由 head.ejs 的 <noscript> 样式强制展开，不会把目录彻底锁死。 %>
    <div class="post-toc is-collapsed" id="post-toc">
      <button class="post-toc-toggle" id="post-toc-toggle" type="button" aria-expanded="false" aria-controls="post-toc-nav">
        <span class="fa fa-list-ul" aria-hidden="true"></span>
        <span class="post-toc-label"><%= monish_t('toc') %></span>
      </button>
      <%# .post-toc-body 是 grid 容器：grid-template-rows 在 1fr ↔ 0fr 之间过渡，
          可以动画到「内容实际高度」，不需要写 max-height 魔数。 %>
      <div class="post-toc-body">
        <nav class="post-toc-nav" id="post-toc-nav" aria-label="<%= monish_t('toc') %>">
          <%- toc(page.content, {
            class: 'toc',
            list_number: false,
            max_depth: cfg.post.toc_depth || 3
          }) %>
        </nav>
      </div>
    </div>
  <% } %>

  <div class="card-body monish-prose" itemprop="articleBody">
    <%- page.content %>
  </div>

  <footer class="card-foot">
    <% if (cfg.post.copyright !== false){ %>
      <div class="post-copyright">
        <p class="post-copyright-line">
          <span class="post-copyright-label"><%= monish_t('copyright') %></span>
          <span class="post-copyright-value"><a href="<%- full_url_for(page.path) %>"><%- full_url_for(page.path) %></a></span>
        </p>
        <p class="post-copyright-note"><%= monish_t('license_note') %></p>
      </div>
    <% } %>

    <% if (cfg.post.prev_next !== false && (page.prev || page.next)){ %>
      <nav class="post-nav" aria-label="<%= monish_t('prev_post') %> / <%= monish_t('next_post') %>">
        <% if (page.prev){ %>
          <a class="post-nav-item post-nav-prev" href="<%- url_for(page.prev.path) %>" rel="prev">
            <span class="post-nav-label"><span class="fa fa-angle-left" aria-hidden="true"></span> <%= monish_t('prev_post') %></span>
            <span class="post-nav-title"><%= page.prev.title %></span>
          </a>
        <% } %>
        <% if (page.next){ %>
          <a class="post-nav-item post-nav-next" href="<%- url_for(page.next.path) %>" rel="next">
            <span class="post-nav-label"><%= monish_t('next_post') %> <span class="fa fa-angle-right" aria-hidden="true"></span></span>
            <span class="post-nav-title"><%= page.next.title %></span>
          </a>
        <% } %>
      </nav>
    <% } %>

    <%- partial('_partial/comments') %>
  </footer>
</article>
