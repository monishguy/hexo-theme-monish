<%
/**
 * 本地搜索浮层。仅 features.search 开启时输出。
 * 设计契约 §3.11。
 */
var cfg = monish_config();
%>
<% if (cfg.features.search){ %>
<div class="search-mask" id="search-mask" hidden></div>
<div class="search-box" id="search-box" role="dialog" aria-modal="true" aria-label="<%= monish_t('search') %>" hidden>
  <div class="search-box-inner">
    <div class="search-field">
      <span class="fa fa-search search-field-icon" aria-hidden="true"></span>
      <input class="search-input" id="search-input" type="search" autocomplete="off" spellcheck="false"
             placeholder="<%= monish_t('search_placeholder') %>" aria-label="<%= monish_t('search') %>">
      <button class="search-close icon-btn" id="search-close" type="button" aria-label="<%= monish_t('close') %>">
        <span class="fa fa-times" aria-hidden="true"></span>
      </button>
    </div>
    <div class="search-results" id="search-results" aria-live="polite">
      <p class="search-hint"><%= monish_t('search_placeholder') %></p>
    </div>
  </div>
</div>
<% } %>
